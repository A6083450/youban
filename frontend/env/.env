VITE_APP_TITLE = '游伴'
VITE_APP_PORT = 9000

VITE_UNI_APPID = '__UNI__D1E5001'
VITE_WX_APPID = 'wx42ddc076b365bf0d'

# 微信开发者工具 CLI 路径，仅当默认安装路径不正确时配置。
# WECHAT_DEVTOOLS_CLI_PATH = '/Applications/wechatwebdevtools.app/Contents/MacOS/cli'

# H5 部署路径。
VITE_APP_PUBLIC_BASE = '/'

# 默认后台请求地址；各 mode 会叠加读取对应的环境文件。
VITE_SERVER_BASEURL = 'https://youban.me'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://youban.me'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://youban.me'

# H5 代理配置。
VITE_APP_PROXY_ENABLE = false
VITE_APP_PROXY_PREFIX = '/fg-api'

# 第二个请求地址。
VITE_SERVER_BASEURL_SECONDARY = 'https://youban.me'

# 认证模式：single | double。
VITE_AUTH_MODE = 'single'

# 原生插件资源复制开关。
VITE_COPY_NATIVE_RES_ENABLE = true
