{
  "name": "youban-backend",
  "version": "2.0.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:wechat": "HOST=0.0.0.0 PORT=7860 YOUBAN_DEV_WECHAT_AUTH=1 bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun run test:parallel",
    "test:serial": "bun test",
    "test:parallel": "bun test --parallel=4 --isolate --timings=tests/timings.json --update-timings",
    "typecheck": "tsc --noEmit",
    "audit:python-tests": "bun run scripts/generate-python-test-disposition.ts --check",
    "browser:skills-fixture": "bun run scripts/skill-admin-browser-fixture.ts",
    "bench:planning-deadlines": "bun run scripts/benchmark-planning-deadlines.ts",
    "bench:real-trip": "bun run scripts/benchmark-real-trip.ts",
    "bench:pi-subagents": "bun run scripts/benchmark-pi-subagents.ts",
    "profile:cpu": "bun --cpu-prof-md --cpu-prof-dir=profiles scripts/benchmark-pi-subagents.ts",
    "profile:heap": "bun --heap-prof-md --heap-prof-dir=profiles scripts/benchmark-pi-subagents.ts",
    "smoke:deployment": "bun run scripts/smoke-deployment.ts",
    "purge:business-data": "bun run scripts/prepare-production-cutover.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.52",
    "@youban/contracts": "file:../shared/contracts",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "pi-hermes-memory": "0.9.6",
    "pi-subagents": "0.53.0",
    "yaml": "2.9.0",
    "yauzl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7",
    "yazl": "3.3.1"
  }
}
