ARG NODE_IMAGE_PREFIX=docker.m.daocloud.io/library
ARG BUN_IMAGE_PREFIX=docker.m.daocloud.io/oven
FROM ${NODE_IMAGE_PREFIX}/node:20-slim AS node-runtime

FROM ${BUN_IMAGE_PREFIX}/bun:1.4
WORKDIR /app

COPY --from=node-runtime /usr/local /usr/local
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.10.0 --activate

COPY shared/contracts ./shared/contracts
WORKDIR /app/shared/contracts
RUN bun install

WORKDIR /app
COPY backend/package.json backend/bun.lock ./backend/
WORKDIR /app/backend
RUN bun install --frozen-lockfile

WORKDIR /app
COPY frontend/package.json frontend/pnpm-lock.yaml ./frontend/
WORKDIR /app/frontend
RUN pnpm install --frozen-lockfile --ignore-scripts

WORKDIR /app
COPY start-dev.sh ./start-dev.sh
RUN chmod +x ./start-dev.sh && mkdir -p /app/data

ENV DATA_DIR=/app/data \
    HOST=0.0.0.0 \
    PORT=7860 \
    YOUBAN_DEV_WECHAT_AUTH=1

EXPOSE 7860 9000
CMD ["./start-dev.sh"]
